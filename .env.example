# ──────────────────────────────────────────────────────────────────────────
# TAG Chile Consolidator — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# This file contains NO secrets — no RUTs, no passwords. Those are prompted
# interactively at runtime and held in memory only.
# ──────────────────────────────────────────────────────────────────────────

# --- LLM navigation layer (Anthropic) — OPTIONAL ------------------------------
# Used only as a fallback when a known selector is not found on a portal page.
# Leave ANTHROPIC_API_KEY empty to run with selectors only (no LLM fallback).
ANTHROPIC_API_KEY=

# Model used by the navigation layer (vision-capable Claude model).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to "false" to disable the LLM fallback entirely (selectors only).
LLM_FALLBACK_ENABLED=true

# --- Runtime behavior ---------------------------------------------------------
# Which profile from config/profiles.yml to run (matches the `id` field).
TAG_PROFILE=default

# Run the browser headless ("true") or headed ("false") for debugging.
HEADLESS=true

# --- Servipag (baseline) — Cloudflare-gated -----------------------------------
# Servipag's "Pago Total TAG" page is behind a mandatory Cloudflare Turnstile
# challenge that a headless browser cannot pass. The Servipag step therefore
# runs HEADED by default so you can clear the "Verifique que es un ser humano"
# checkbox once; the cf_clearance cookie is cached in SERVIPAG_STATE_DIR and
# reused on later runs. Set this to "true" to force headless (only works while a
# valid cached cookie exists).
SERVIPAG_HEADLESS=false

# Persistent Chrome profile dir where the Cloudflare cookie is cached.
SERVIPAG_STATE_DIR=.servipag

# Only set to "true" behind a TLS-intercepting (MITM) corporate proxy where the
# browser would otherwise reject the proxy's certificate. Leave false normally.
SERVIPAG_IGNORE_HTTPS_ERRORS=false

# Where the consolidated .xlsx workbook is written.
OUTPUT_DIR=./output

# Directory for transient downloads + failure screenshots.
DOWNLOAD_DIR=./.downloads

# Log level: error | warn | info | debug
LOG_LEVEL=info

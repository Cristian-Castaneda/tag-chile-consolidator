# ──────────────────────────────────────────────────────────────────────────
# TAG Chile Consolidator — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# This file contains NO secrets — no RUTs, no passwords. Those are prompted
# interactively at runtime and held in memory only.
# ──────────────────────────────────────────────────────────────────────────

# --- Google Sheets (output) ---------------------------------------------------
# The target spreadsheet ID (the long id in the Sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit )
GOOGLE_SHEET_ID=

# Path to the Google service account JSON key with write access to the sheet.
# In Cloud Run, mount the secret and point this at the mounted file.
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/service-account.json

# --- LLM navigation layer (Anthropic) ----------------------------------------
# Used only as a fallback when a known selector is not found on a portal page.
ANTHROPIC_API_KEY=

# Model used by the navigation layer (vision-capable Claude model).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to "false" to disable the LLM fallback entirely (selectors only).
LLM_FALLBACK_ENABLED=true

# --- Runtime behavior ---------------------------------------------------------
# Which profile from config/profiles.yml to run (matches the `id` field).
TAG_PROFILE=default

# Period to scrape, format YYYY-MM. Defaults to the current month if empty.
TAG_PERIOD=

# Run the browser headless ("true") or headed ("false") for debugging.
HEADLESS=true

# Directory for transient downloads (cleared at the end of each run).
DOWNLOAD_DIR=./.downloads

# Log level: error | warn | info | debug
LOG_LEVEL=info
